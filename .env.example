# OpenAI 兼容接口（官方或中转）
# 必填：留空会直接报错，不要填占位符
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=120
OPENAI_MAX_RETRIES=2

# Supervisor 用更便宜的小模型（留空则跟随 OPENAI_MODEL）
MULTI_AGENT_SUPERVISOR_MODEL=

# 调度、单专家步数与上下文预算
MULTI_AGENT_MAX_TURNS=12
MULTI_AGENT_WORKER_STEPS=25
# 发给模型的上下文 token 上限；0 表示不裁剪
MULTI_AGENT_CONTEXT_TOKENS=12000

# 检查点：SQLite 路径；填 memory 用内存（进程退出即丢）
MULTI_AGENT_CHECKPOINT_DB=.multi_agent/checkpoints.sqlite

# 审批审计日志（JSONL）；填 off 关闭
MULTI_AGENT_AUDIT_LOG=.multi_agent/approvals.jsonl

# 笔记目录（相对当前工作目录）
MULTI_AGENT_NOTES_DIR=notes

# 日志级别：DEBUG / INFO / WARNING
MULTI_AGENT_LOG_LEVEL=WARNING
