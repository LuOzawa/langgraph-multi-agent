# OpenAI 兼容接口（官方或中转）
# 必填：留空会直接报错，不要填占位符
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=120
OPENAI_MAX_RETRIES=2

# Supervisor 用更便宜的小模型（留空则跟随 OPENAI_MODEL）
MULTI_AGENT_SUPERVISOR_MODEL=

# 调度、单专家步数与上下文预算
MULTI_AGENT_MAX_TURNS=12
MULTI_AGENT_WORKER_STEPS=25
# 发给模型的上下文 token 上限；0 表示不裁剪
MULTI_AGENT_CONTEXT_TOKENS=12000

# 检查点：SQLite 路径；填 memory 用内存（进程退出即丢）
MULTI_AGENT_CHECKPOINT_DB=.multi_agent/checkpoints.sqlite

# 审批审计日志（JSONL）；填 off 关闭
MULTI_AGENT_AUDIT_LOG=.multi_agent/approvals.jsonl

# 笔记目录（相对当前工作目录）
MULTI_AGENT_NOTES_DIR=notes

# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL（非法值启动即报错）
MULTI_AGENT_LOG_LEVEL=WARNING

# ---- HTTP API 服务（multi-agent-api）----
# 命令行参数优先于这里的值；默认只监听回环地址
MULTI_AGENT_API_HOST=127.0.0.1
MULTI_AGENT_API_PORT=8000
# 并发任务数；单进程运行，不要给 uvicorn 开多 worker
MULTI_AGENT_API_MAX_WORKERS=4
# 单任务执行超时（秒）；0 表示不限
MULTI_AGENT_API_TASK_TIMEOUT=1800
# 任务记录保留期（秒）；0 表示关闭回收
MULTI_AGENT_API_RETENTION=86400
# 任务表容量上限，超限只淘汰已结束记录
MULTI_AGENT_API_MAX_RECORDS=1000
# 任务表持久化路径；填 memory 只用进程内任务表
MULTI_AGENT_API_TASK_DB=.multi_agent/tasks.sqlite
# 访问令牌；留空不鉴权（默认只监听回环地址）
MULTI_AGENT_API_TOKEN=
# 每客户端 IP 每分钟请求上限；0 关闭
MULTI_AGENT_API_RATE_LIMIT=0

# 审查驳回上限：达到后 supervisor 直接收尾（0 表示一次驳回即停）
MULTI_AGENT_MAX_REJECTIONS=1
